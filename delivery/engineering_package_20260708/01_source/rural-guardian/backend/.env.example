# ============================================
# 乡村守护者 - 后端环境配置
# 使用方式: 复制为 .env 并修改配置
# ============================================

# 运行环境 (development | production)
NODE_ENV=development

# 是否允许演示登录 (生产环境必须设为 false)
ALLOW_DEMO_LOGIN=true

# CORS 域名白名单（生产环境用逗号分隔多个域名）
CORS_ORIGINS=

# 日志级别 (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# 数据库文件路径（相对于 backend 目录）
# DB_PATH=data/rural_guardian.db
